# Copy to .env.local and fill in. Never commit real values.
# PostgreSQL (EU-hosted in production, TLS required: add ?sslmode=require)
DATABASE_URL=postgres://k:change-me@localhost:5432/k_dev

# Better Auth: secret >= 32 chars (openssl rand -base64 48) and public base URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Master key wrapping per-user data keys: 32 random bytes in base64
# (openssl rand -base64 32). Losing it makes encrypted data unreadable.
DATA_ENCRYPTION_KEY=

# Open sign-up only to create the first account, then set back to false.
ALLOW_SIGNUP=false

# Web push (npx web-push generate-vapid-keys). Optional.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Shared secret for the reminder cron endpoint (openssl rand -base64 48). Optional.
CRON_SECRET=
